# Salin ke .env.local untuk pengembangan. Di Vercel isi lewat Project Settings > Environment Variables.
# JANGAN commit file .env / .env.local yang berisi nilai asli.

# Supabase (nama pasti key bisa berbeda; lihat dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # kunci publik, aman di browser, dilindungi RLS
SUPABASE_SERVICE_ROLE_KEY=            # RAHASIA. Hanya server. Tidak boleh berawalan NEXT_PUBLIC_

# Gemini (hanya server)
GEMINI_API_KEY=
GEMINI_MODEL=                         # ambil nama model dari dokumentasi Google terbaru

# Aplikasi
PROMPT_VERSION=1
DAILY_QUOTA_PER_USER=30
MAX_UPLOAD_MB=10
