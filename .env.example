# Salin ke .env.local untuk pengembangan. Di Vercel isi lewat Project Settings > Environment Variables.
# JANGAN commit file .env / .env.local yang berisi nilai asli.

# Supabase (nama pasti key bisa berbeda; lihat dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # kunci publik, aman di browser, dilindungi RLS
SUPABASE_SERVICE_ROLE_KEY=            # RAHASIA. Hanya server. Tidak boleh berawalan NEXT_PUBLIC_

# Gemini (hanya server)
GEMINI_API_KEY=
GEMINI_MODEL=                         # ambil nama model dari dokumentasi Google terbaru

# Aplikasi
PROMPT_VERSION=7
DAILY_QUOTA_PER_USER=30                  # 0 = tanpa batas harian (pencatatan tetap jalan), tidak disarankan bila akun dipakai banyak orang
DEV_EMAILS=                              # Daftar email/username dev dipisah koma (kuota tanpa batas khusus akun dev)
MAX_UPLOAD_MB=10
NEXT_PUBLIC_ENABLE_MAGIC_LINK=false      # Atur true hanya bila custom SMTP provider (Resend/SendGrid) sudah dipasang
NEXT_PUBLIC_ENABLE_SIGNUP=false          # Atur false untuk menyembunyikan formulir pendaftaran publik di UI (Opsi A)
